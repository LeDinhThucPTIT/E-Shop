PORT=5000
MONGO_URI=mongodb://127.0.0.1:27018/neuralstore?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
# MoMo sandbox credentials from your merchant account. Never expose these in VITE_*.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:5173/checkout/payment-result
# Set to your public HTTPS backend URL (or development tunnel), not localhost.
MOMO_IPN_URL=
MOMO_API_BASE_URL=https://test-payment.momo.vn/v2/gateway/api
